filters:
  and:
    - file.hasTag("opening-card")
formulas:
  card: "file.asLink()"
  key_positions: "if(note.positions, note.positions.length, 0)"
properties:
  formula.card:
    displayName: Opening card
  formula.key_positions:
    displayName: Key positions
  note.opening:
    displayName: Opening
  note.family:
    displayName: Family
  note.eco:
    displayName: ECO
  note.repertoire:
    displayName: Played as
  note.parent:
    displayName: Branch of
  note.moves:
    displayName: Line
  note.updated:
    displayName: Updated
views:
  - type: table
    name: My White repertoire
    filters:
      and:
        - note.repertoire == "white"
    groupBy:
      property: note.family
      direction: ASC
    order:
      - formula.card
      - note.eco
      - note.parent
      - formula.key_positions
      - note.updated
    sort:
      - property: note.moves
        direction: ASC
  - type: table
    name: My Black repertoire
    filters:
      and:
        - note.repertoire == "black"
    groupBy:
      property: note.family
      direction: ASC
    order:
      - formula.card
      - note.eco
      - note.parent
      - formula.key_positions
      - note.updated
    sort:
      - property: note.moves
        direction: ASC
  - type: table
    name: By family
    groupBy:
      property: note.family
      direction: ASC
    order:
      - formula.card
      - note.repertoire
      - note.eco
      - note.parent
      - formula.key_positions
      - note.updated
    sort:
      - property: note.moves
        direction: ASC
