{
  "mcpServers": {
    "chess-engine-mcp": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp_stdio_http_proxy.mjs"
      ],
      "env": {
        "MCP_HTTP_HOST": "chesspi",
        "MCP_HTTP_PORT": "4100",
        "MCP_HTTP_PATH": "/mcp",
        "MCP_HTTP_TIMEOUT_MS": "120000",
        "MCP_HTTP_TLS": "0"
      }
    }
  }
}
